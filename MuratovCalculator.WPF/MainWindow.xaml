<Window x:Class="MuratovCalculator.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор — Муратов"
        Height="440" Width="340"
        MinHeight="440" MinWidth="340"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="Display"
                 Grid.Row="0"
                 FontSize="28"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 IsReadOnly="True"
                 Text="0"/>

        <UniformGrid Grid.Row="1" Rows="5" Columns="4" Margin="0,10,0,0">
            <Button Content="C"  Margin="2" FontSize="18" Click="Clear_Click"/>
            <Button Content="⌫"  Margin="2" FontSize="18" Click="Backspace_Click"/>
            <Button Content="^"  Margin="2" FontSize="18" Click="Operator_Click"/>
            <Button Content="/"  Margin="2" FontSize="18" Click="Operator_Click"/>

            <Button Content="7" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="8" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="9" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="*" Margin="2" FontSize="18" Click="Operator_Click"/>

            <Button Content="4" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="5" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="6" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="-" Margin="2" FontSize="18" Click="Operator_Click"/>

            <Button Content="1" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="2" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="3" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="+" Margin="2" FontSize="18" Click="Operator_Click"/>

            <Button Content="±" Margin="2" FontSize="18" Click="Sign_Click"/>
            <Button Content="0" Margin="2" FontSize="18" Click="Digit_Click"/>
            <Button Content="." Margin="2" FontSize="18" Click="Dot_Click"/>
            <Button Content="=" Margin="2" FontSize="18" Click="Equals_Click"/>
        </UniformGrid>
    </Grid>
</Window>